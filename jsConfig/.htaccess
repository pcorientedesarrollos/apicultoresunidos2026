Options +FollowSymLinks
RewriteEngine on
RewriteCond %{HTTP_HOST} ^apicultoresunidos.com [NC]
RewriteRule ^(.*)$ http://www.apicultoresunidos.com/$1 [R=301,L]

<FilesMatch "\.(jpg|png|jpeg|css)$">
Header set Cache-Control "private, max-age=604800"
</FilesMatch>

<Files .htaccess>
Order Allow,Deny
Deny from All
</Files>

Options All -Indexes